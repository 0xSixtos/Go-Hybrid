# Build artifacts
/target/
/bin/
/obj/
*.o
*.a
*.so
*.dylib
*.exe
hybrid
hybridc

# Rust
**/*.rs.bk

# Go
*.test
*.out
go.sum backup files: *.sum~

# Jobs & results (commit summaries only, not bulk logs)
jobs/*/result/logs/
jobs/*/result/*.bin
results/

# Spike scratch dirs (RESULTS.md is committed, throwaway code is not)
# spike work dirs: source IS committed (workers must run them); artifacts are not

# Logs & caches
*.log
.cache/
# NOTE: Cargo.lock and go.sum ARE committed per SPEC.md Phase 5 (reproducible builds)
/
# hyb build outputs (MVP-0 walking-skeleton artifacts)
/build/

# Editor/OS noise
.DS_Store
*.swp
.idea/
.vscode/

# NEVER COMMIT SECRETS (tokens, keys). If a filename here looks like a leak, fix the source.
*.token
*.secret
.env*
jobs/*/result/raw/repo/
jobs/*/result/raw/__*
spikes/*/work/**/target/
spikes/*/work/**/*.a
spikes/*/work/**/bin/
spikes/*/work/**/*.o
spikes/*/work/**/*.test

# Python bytecode
__pycache__/
*.pyc
